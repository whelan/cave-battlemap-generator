{
  "name": "cave-battlemap-generator",
  "version": "1.0.0",
  "description": "Dependency-free cave battlemap generator: JSON spec in, ink line-drawing SVG out.",
  "type": "module",
  "main": "cavemap.js",
  "bin": { "cavemap": "cli.mjs" },
  "scripts": {
